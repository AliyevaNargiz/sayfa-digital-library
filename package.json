{
  "name": "necle-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/start-portable.mjs",
    "test": "node --test",
    "dev:cloud": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply necle-library --local",
    "db:remote": "wrangler d1 migrations apply necle-library --remote",
    "build:client": "node scripts/build-client.mjs",
    "db:generate": "drizzle-kit generate",
    "start:portable": "node scripts/start-portable.mjs",
    "package:source": "npm run build:client && python3 scripts/package-source.py"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^6.0.1",
    "wrangler": "^4.0.0"
  }
}
